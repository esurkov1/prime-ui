{
  "name": "prime-ui-kit",
  "version": "0.9.1",
  "packageManager": "bun@1.3.13",
  "description": "React 19 UI kit for product interfaces: 57 composable components on one design contract — forms, selects, tables, overlays, navigation, app shell. CSS Modules, --prime-* tokens, light and dark themes, TypeScript, a11y. Ships COMPONENT.md docs and copyable examples.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "react",
    "react-ui",
    "react-components",
    "react19",
    "ui-kit",
    "ui-library",
    "component-library",
    "design-system",
    "design-tokens",
    "typescript",
    "css-modules",
    "css-variables",
    "dark-mode",
    "theming",
    "accessible",
    "a11y",
    "admin-dashboard",
    "dashboard",
    "forms",
    "data-table",
    "datepicker",
    "date-range-picker",
    "select",
    "multiselect",
    "modal",
    "drawer",
    "dropdown",
    "popover",
    "tooltip",
    "toast",
    "command-palette",
    "sidebar",
    "app-shell",
    "color-picker",
    "file-upload",
    "otp-input"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esurkov1/prime-ui.git"
  },
  "bugs": {
    "url": "https://github.com/esurkov1/prime-ui/issues"
  },
  "homepage": "https://github.com/esurkov1/prime-ui#readme",
  "files": [
    "dist",
    "src/styles/*.css",
    "src/components/**/COMPONENT.md",
    "src/layout/**/COMPONENT.md",
    "src/components/**/examples/**",
    "src/layout/**/examples/**",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "date-fns": "^4.1.0",
    "esbuild": "^0.27.0",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "date-fns": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-aria-components": "^1.16.0"
  },
  "peerDependenciesMeta": {
    "react-aria-components": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./color-picker": {
      "types": "./dist/color-picker.d.ts",
      "default": "./dist/color-picker.js"
    },
    "./bundle.css": "./dist/index.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./reset.css": "./src/styles/reset.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme-light.css": "./src/styles/theme-light.css",
    "./theme-dark.css": "./src/styles/theme-dark.css"
  },
  "scripts": {
    "clean": "rm -rf dist .dts-stage playground/dist",
    "tokens:build": "bun run scripts/build-tokens.ts",
    "docs:build": "bun run scripts/build-docs.ts",
    "build": "bun run tokens:build && bun run scripts/bundle-lib.ts",
    "prepublishOnly": "bun run clean && bun run build",
    "playground:dev": "vite playground --config playground/vite.config.ts",
    "check": "biome check .",
    "check:ci": "biome ci .",
    "check:fix": "biome check . --write --unsafe",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run check:ci && bun run typecheck && bun run test && bun run verify:tokens && bun run build",
    "verify:tokens": "bun run tokens:build && git diff --exit-code -- src/styles/tokens.css src/styles/theme-light.css src/styles/theme-dark.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "dependencies": {
    "lucide-react": "^0.577.0"
  }
}
